{
	/* -> General
	   (default: true)
	*/
	"rarityTooltip": true,
	// (default: 1.0)
	"scaleFactor": 1.0,
	/* -> Border
	   RARITY/ITEM_NAME/CUSTOM (default: RARITY)
	*/
	"borderColor": "RARITY",
	"customBorderColors": {
		// (default: #5000FF50)
		"common": "#5000FF50",
		// (default: #FFFF55FF)
		"uncommon": "#FFFF55FF",
		// (default: #55FFFFFF)
		"rare": "#55FFFFFF",
		// (default: #FF00FFFF)
		"epic": "#FF00FFFF",
		// (default: #5000FF50)
		"endColor": "#5000FF50"
	},
	/* -> Background
	   (default: #100010F0)
	*/
	"backgroundColor": "#100010F0",
	/* -> Food & Drinks
	   (default: true)
	*/
	"hungerTooltip": true,
	// (default: true)
	"saturationTooltip": true,
	// OFF/WITHOUT_ICONS/WITH_ICONS (default: WITH_ICONS)
	"effectsTooltip": "WITH_ICONS",
	/* -> Mobs
	   (default: true)
	*/
	"armorTooltip": true,
	// (default: true)
	"bucketTooltip": true,
	// (default: true)
	"spawnEggTooltip": true,
	/* -> Durability
	   OFF/VALUE/PERCENTAGE (default: VALUE)
	*/
	"durabilityTooltip": "VALUE",
	// (default: false)
	"durabilityBar": false
}